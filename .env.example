# --- Database (Supabase Postgres - NEW project, not the Unis one) ---
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.xxxxxxxxxxxx
DB_PASSWORD=

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# LOCAL values are below. On Railway flip these to true / None.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# --- App ---
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
SUPPORT_EMAIL=hello@easycode.dev

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=easycode-client-assets

# --- Resend ---
RESEND_API_KEY=
RESEND_FROM=EasyCode <hello@easycode.dev>
RESEND_ENABLED=false

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Bootstrap the first admin (runs once on startup, then remove) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
